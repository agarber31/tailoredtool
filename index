<script>
  // Scripted Size & Fit Advisor demo — deterministic, no external calls
  const agentBody = document.getElementById('agentBody');

  const answers = {
    'snug-brandA': "Based on what you told us, we'd recommend a <strong>Small</strong>. This jacket runs slightly generous through the shoulders, so sizing down from your usual keeps the fit snug the way you like it.",
    'snug-brandB': "Based on what you told us, we'd recommend a <strong>Medium</strong>. Compared to your usual brand, this cut sits closer to the body, so your true size should already feel snug.",
    'relaxed-brandA': "Based on what you told us, we'd recommend a <strong>Medium</strong>. Sizing up one from your usual gives you room through the shoulders for a relaxed, easy layer.",
    'relaxed-brandB': "Based on what you told us, we'd recommend a <strong>Large</strong>. This runs a little trim, so going up a size gets you the relaxed fit you're after."
  };

  function renderStep1() {
    agentBody.innerHTML = `
      <p class="agent-question">Which brand's sizing are you used to?</p>
      <div class="agent-options">
        <button class="agent-opt" data-brand="brandA">A similar outdoor brand</button>
        <button class="agent-opt" data-brand="brandB">A slimmer, fitted brand</button>
      </div>
    `;
    agentBody.querySelectorAll('.agent-opt').forEach(btn => {
      btn.addEventListener('click', () => renderStep2(btn.dataset.brand));
    });
  }

  function renderStep2(brand) {
    agentBody.innerHTML = `
      <p class="agent-question">How do you like your fit?</p>
      <div class="agent-options">
        <button class="agent-opt" data-fit="snug">Snug</button>
        <button class="agent-opt" data-fit="relaxed">Relaxed</button>
      </div>
    `;
    agentBody.querySelectorAll('.agent-opt').forEach(btn => {
      btn.addEventListener('click', () => renderResult(brand, btn.dataset.fit));
    });
  }

  function renderResult(brand, fit) {
    const key = `${fit}-${brand}`;
    agentBody.innerHTML = `
      <div class="agent-answer">${answers[key]}</div>
      <button class="agent-restart" id="restartBtn">Try another combination</button>
    `;
    document.getElementById('restartBtn').addEventListener('click', renderStep1);
  }

  renderStep1();
</script>

