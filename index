<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tailored Tool — Custom AI Agents for Shopify Stores</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --paper: #F1F2ED;
    --paper-raised: #FFFFFF;
    --ink: #14181C;
    --ink-soft: #4A5058;
    --tag-red: #C23B2E;
    --tag-red-dark: #9C2E23;
    --barcode-teal: #1F6E5C;
    --kraft: #E4DDC9;
    --kraft-line: #CFC6AC;
    --line: #D8D6CE;
    --radius: 4px;
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    * { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 16px;
    line-height: 1.5;
  }

  .display {
    font-family: 'Archivo Black', 'Arial Black', sans-serif;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .mono {
    font-family: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }

  a { color: inherit; }
  button { font-family: inherit; }

  :focus-visible {
    outline: 3px solid var(--barcode-teal);
    outline-offset: 2px;
  }

  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 28px;
  }

  /* ---------- NAV ---------- */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(241,242,237,0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line);
  }
  .nav .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .nav-mark {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
  }
  .nav-mark .tag-icon { width: 22px; height: 22px; }
  .nav-cta {
    background: var(--ink);
    color: var(--paper);
    border: none;
    padding: 12px 20px;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .nav-cta:hover { background: var(--tag-red-dark); }

  /* ---------- HERO ---------- */
  .hero {
    padding: 96px 0 72px;
    border-bottom: 1px solid var(--line);
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--barcode-teal);
    background: #E7F1EE;
    border: 1px solid #C3DCD5;
    padding: 6px 12px;
    border-radius: 999px;
    margin-bottom: 28px;
  }
  .eyebrow::before { content: "●"; font-size: 8px; }
  .hero h1 {
    font-size: clamp(38px, 5.6vw, 68px);
    line-height: 1.03;
    margin: 0 0 24px;
    max-width: 16ch;
  }
  .hero h1 .accent { color: var(--tag-red); }
  .hero-sub {
    font-size: 19px;
    color: var(--ink-soft);
    max-width: 46ch;
    margin: 0 0 36px;
  }
  .hero-actions { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .btn-primary {
    background: var(--tag-red);
    color: #fff;
    border: none;
    padding: 16px 28px;
    border-radius: var(--radius);
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .btn-primary:hover { background: var(--tag-red-dark); transform: translateY(-1px); }
  .hero-note {
    font-size: 14px;
    color: var(--ink-soft);
  }

  /* ---------- POSITIONING ---------- */
  .positioning {
    padding: 72px 0;
    border-bottom: 1px solid var(--line);
  }
  .positioning-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .positioning h2 {
    font-size: clamp(26px, 3.2vw, 36px);
    line-height: 1.15;
    margin: 0 0 16px;
    max-width: 14ch;
  }
  .positioning p { color: var(--ink-soft); font-size: 16px; max-width: 46ch; }
  .compare {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .compare-row {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 12px;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper-raised);
    font-size: 15px;
  }
  .compare-row.bad { color: var(--ink-soft); }
  .compare-row.good { border-color: var(--barcode-teal); background: #F3F8F6; font-weight: 500; }
  .compare-mark { font-family: 'JetBrains Mono', monospace; font-weight: 700; }
  .compare-row.bad .compare-mark { color: var(--tag-red); }
  .compare-row.good .compare-mark { color: var(--barcode-teal); }

  /* ---------- DEMO ---------- */
  .demo {
    padding: 80px 0;
    border-bottom: 1px solid var(--line);
    background: var(--paper-raised);
  }
  .section-head { max-width: 60ch; margin: 0 0 44px; }
  .section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 10px;
  }
  .section-head h2 { font-size: clamp(26px, 3.2vw, 34px); margin: 0 0 12px; line-height: 1.15; }
  .section-head p { color: var(--ink-soft); margin: 0; font-size: 16px; }

  .demo-card {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--paper);
  }
  .demo-shop {
    padding: 32px;
    border-right: 1px solid var(--line);
  }
  .demo-shop-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--ink-soft);
    margin-bottom: 18px;
  }
  .demo-product {
    width: 100%;
    aspect-ratio: 4/3;
    border-radius: 6px;
    background: linear-gradient(135deg, #E4DDC9 0%, #D6CDB2 100%);
    margin-bottom: 18px;
    position: relative;
    overflow: hidden;
  }
  .demo-product::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(115deg, rgba(20,24,28,0.05) 0 2px, transparent 2px 26px);
  }
  .demo-product-name { font-weight: 700; font-size: 17px; margin: 0 0 4px; }
  .demo-product-price { font-family: 'JetBrains Mono', monospace; color: var(--ink-soft); font-size: 15px; }

  .demo-agent { padding: 28px 32px; display: flex; flex-direction: column; }
  .agent-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    font-weight: 700;
    font-size: 15px;
  }
  .agent-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--barcode-teal); flex-shrink: 0; }
  .agent-body { flex: 1; }
  .agent-question { font-size: 15px; margin: 0 0 14px; color: var(--ink-soft); }
  .agent-options { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 8px; }
  .agent-opt {
    border: 1px solid var(--line);
    background: var(--paper-raised);
    padding: 10px 16px;
    border-radius: 999px;
    font-size: 14px;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .agent-opt:hover { border-color: var(--barcode-teal); background: #F3F8F6; }
  .agent-answer {
    background: #F3F8F6;
    border: 1px solid #C3DCD5;
    border-radius: 6px;
    padding: 18px;
    font-size: 14.5px;
    line-height: 1.55;
  }
  .agent-answer strong { color: var(--barcode-teal); }
  .agent-restart {
    margin-top: 16px;
    background: none;
    border: none;
    text-decoration: underline;
    font-size: 13px;
    color: var(--ink-soft);
    cursor: pointer;
    align-self: flex-start;
  }
  .demo-fine {
    text-align: center;
    font-size: 13px;
    color: var(--ink-soft);
    margin-top: 18px;
  }

  /* ---------- MENU ---------- */
  .menu { padding: 80px 0; border-bottom: 1px solid var(--line); }
  .menu-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .tag-card {
    position: relative;
    background: var(--kraft);
    border: 1px solid var(--kraft-line);
    border-radius: 10px;
    padding: 26px 20px 22px;
    display: flex;
    flex-direction: column;
    min-height: 280px;
  }
  .tag-card.custom {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .tag-card.custom .tag-card-desc { color: #C9CDD2; }
  .tag-card.custom .tag-price-label { color: #9BA3AB; }
  .tag-hole {
    position: absolute;
    top: 16px;
    right: 18px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--kraft-line);
  }
  .tag-card.custom .tag-hole { background: var(--ink); box-shadow: inset 0 0 0 1px #4A5058; }
  .tag-num { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--ink-soft); margin-bottom: 14px; }
  .tag-card.custom .tag-num { color: #9BA3AB; }
  .tag-card h3 { font-size: 18px; margin: 0 0 10px; line-height: 1.25; }
  .tag-card-desc { font-size: 14px; color: var(--ink-soft); flex: 1; margin: 0 0 18px; }
  .tag-price-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-soft); margin-bottom: 4px; }
  .tag-price { font-family: 'JetBrains Mono', monospace; font-weight: 600; font-size: 20px; margin-bottom: 2px; }
  .tag-price-sub { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--ink-soft); }
  .tag-card.custom .tag-price-sub { color: #9BA3AB; }

  /* ---------- HOW IT WORKS ---------- */
  .how { padding: 80px 0; border-bottom: 1px solid var(--line); background: var(--paper-raised); }
  .how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .how-step-num { font-family: 'JetBrains Mono', monospace; font-size: 14px; color: var(--tag-red); font-weight: 700; margin-bottom: 14px; }
  .how-step h3 { font-size: 19px; margin: 0 0 10px; }
  .how-step p { color: var(--ink-soft); font-size: 15px; margin: 0; }

  /* ---------- FOOTER CTA ---------- */
  .footer-cta { padding: 96px 0; text-align: center; }
  .footer-cta h2 { font-size: clamp(28px, 4vw, 42px); max-width: 18ch; margin: 0 auto 20px; line-height: 1.1; }
  .footer-cta p { color: var(--ink-soft); font-size: 17px; max-width: 44ch; margin: 0 auto 32px; }
  .contact-note {
    margin-top: 24px;
    font-size: 13px;
    color: var(--ink-soft);
    font-family: 'JetBrains Mono', monospace;
  }
  footer {
    border-top: 1px solid var(--line);
    padding: 28px 0;
    font-size: 13px;
    color: var(--ink-soft);
    display: flex;
    justify-content: space-between;
  }

  @media (max-width: 860px) {
    .positioning-grid { grid-template-columns: 1fr; gap: 36px; }
    .demo-card { grid-template-columns: 1fr; }
    .demo-shop { border-right: none; border-bottom: 1px solid var(--line); }
    .menu-grid { grid-template-columns: repeat(2, 1fr); }
    .how-grid { grid-template-columns: 1fr; gap: 40px; }
  }
  @media (max-width: 520px) {
    .menu-grid { grid-template-columns: 1fr; }
    .hero { padding: 64px 0 48px; }
  }
</style>
</head>
