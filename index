<script>
const WORKER_URL = "https://tailoredtool.drewgarber31.workers.dev";

let currentSpec = null;
let currentSite = null;
let currentBrand = null;

function showFallback(){
  document.getElementById('fallbackRow').style.display = 'block';
  document.getElementById('bizInput').focus();
}

const LOADING_STEPS = [
  'Reading your website…',
  'Understanding your business…',
  'Designing your tool…',
  'Writing your spec…'
];

let loadingTimer = null;
function runLoadingText(){
  let i = 0;
  const el = document.getElementById('loadingText');
  el.textContent = LOADING_STEPS[0];
  loadingTimer = setInterval(()=>{
    i = Math.min(i + 1, LOADING_STEPS.length - 1);
    el.textContent = LOADING_STEPS[i];
  }, 3200);
}

function esc(str){
  return String(str == null ? '' : str)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

async function scanSite(){
  const siteVal = document.getElementById('siteInput').value.trim();
  const bizEl = document.getElementById('bizInput');
  const bizVal = bizEl ? bizEl.value.trim() : '';
  if(!siteVal && !bizVal) return;

  const askView = document.getElementById('askView');
  const loadingView = document.getElementById('loadingView');
  const answerView = document.getElementById('answerView');
  const goBtn = document.getElementById('goBtn');

  goBtn.disabled = true;
  askView.style.display = 'none';
  answerView.classList.remove('show');
  loadingView.style.display = 'block';
  runLoadingText();

  try{
    const res = await fetch(WORKER_URL, {
      method:'POST',
      headers:{ 'Content-Type':'application/json' },
      body: JSON.stringify({ url: siteVal, business: bizVal })
    });
    const data = await res.json();
    clearInterval(loadingTimer);
    loadingView.style.display = 'none';

    if(data.spec){
      currentSpec = data.spec;
      currentSite = data.site || null;
      currentBrand = data.brand || null;
      renderSpec(data.spec);
    } else {
      renderError(data.error || 'Something went wrong. Give it another go.', data.needsFallback);
    }
    answerView.classList.add('show');
  }catch(e){
    clearInterval(loadingTimer);
    loadingView.style.display = 'none';
    renderError('We couldn\'t reach the scanner just then. Try once more in a moment.');
    answerView.classList.add('show');
  }
  goBtn.disabled = false;
}

function renderError(msg, needsFallback){
  document.getElementById('specOut').innerHTML = `
    <p class="spec-err">${esc(msg)}</p>
    <div class="spec-actions" style="margin-top:20px;">
      ${needsFallback ? '<button class="btn-deposit" onclick="resetScan(true)">Describe my business instead</button>' : ''}
      <button class="spec-again" onclick="resetScan()">Try again</button>
    </div>`;
}

function renderSpec(s){
  const features = (s.features || []).map(f => `<li>${esc(f)}</li>`).join('');
  const priceFmt = '$' + Number(s.price || 0).toLocaleString();
  const remaining = '$' + Math.max(0, Number(s.price || 0) - 250).toLocaleString();

  document.getElementById('specOut').innerHTML = `
    <div class="spec-verified">
      <span class="tick">✓</span>
      <span><strong style="color:var(--text)">We read your site.</strong> ${esc(s.business_summary)}</span>
    </div>

    <span class="spec-tier">${esc(s.tier)} build</span>
    <div class="spec-name">${esc(s.tool_name)}</div>
    <div class="spec-tagline">${esc(s.tagline)}</div>

    <div class="spec-block">
      <div class="spec-label">What it does</div>
      <p class="spec-text">${esc(s.what_it_does)}</p>
    </div>

    <div class="spec-block">
      <div class="spec-label">Where it lives on your site</div>
      <p class="spec-text">${esc(s.where_it_goes)}</p>
    </div>

    <div class="spec-block">
      <div class="spec-label">The problem it solves</div>
      <p class="spec-text">${esc(s.problem_solved)}</p>
    </div>

    <div class="spec-block">
      <div class="spec-label">What you get</div>
      <ul class="spec-features">${features}</ul>
    </div>

    <div class="spec-block">
      <div class="spec-label">What it means for you</div>
      <p class="spec-text">${esc(s.impact)}</p>
    </div>

    <div class="spec-price-row">
      <div class="spec-price">
        <div class="amt">${priceFmt}</div>
        <div class="sub">One-time. No monthly fees, ever.</div>
      </div>
      <div class="spec-time">
        <div class="k">Ready in</div>
        <div class="v">${esc(s.build_days)} business days</div>
      </div>
    </div>

    <div class="build-cta" id="buildCta">
      <h4>Want to see it actually working?</h4>
      <p>We'll build the real thing right now — your colours, your content, live in your browser. Takes about a minute.</p>
      <button class="btn-deposit" onclick="buildItLive()">Build it now — free</button>
    </div>

    <div class="build-stage" id="buildStage" style="display:none;">
      <div class="build-frame-wrap">
        <div class="build-chrome">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="addr" id="buildAddr">your site</span>
        </div>
        <iframe class="build-frame" id="buildFrame" title="Live preview of your tool"
                sandbox="allow-scripts allow-forms"></iframe>
      </div>
      <div class="build-caption">
        <span class="build-live"><span class="pulse"></span>This is real and working — try typing in it</span>
        <span>Installed on your site when you reserve.</span>
      </div>
    </div>

    <div class="offer-strip">
      <b>Reserve within 48 hours and take 15% off</b> — plus first slot in the build queue.
    </div>

    <div class="spec-actions" style="margin-top:20px;">
      <button class="btn-deposit" onclick="startDeposit()">Reserve my build — $250 deposit</button>
      <button class="btn-ghost" onclick="requestChanges()">Request changes first</button>
      <button class="spec-again" onclick="resetScan()">Scan a different site</button>
    </div>

    <div class="trust-row">
      <div class="trust-item"><b>Fully refundable</b>Change your mind within 7 days and we return the deposit, no questions.</div>
      <div class="trust-item"><b>It comes off the total</b>Your $250 credits toward the build. Balance of ${remaining} only when you're happy.</div>
      <div class="trust-item"><b>Price is locked</b>The quote above is what you pay. No scope creep, no surprise invoices.</div>
    </div>

    <p style="margin-top:18px; font-size:12.5px; color:var(--dim);">
      This spec is a proposal based on your public website, not a binding contract. We'll confirm every detail with you before any work starts.
    </p>`;
}

const BUILD_STEPS = [
  'Reading your brand…',
  'Choosing colours and type…',
  'Writing the interface…',
  'Reviewing the code…',
  'Almost there…'
];

async function buildItLive(){
  if(!currentSpec) return;
  const cta = document.getElementById('buildCta');
  const stage = document.getElementById('buildStage');

  cta.innerHTML = '<div class="loading"><span class="spin"></span><span id="buildText">Reading your brand…</span></div>';

  let i = 0;
  const t = setInterval(()=>{
    i = Math.min(i + 1, BUILD_STEPS.length - 1);
    const el = document.getElementById('buildText');
    if(el) el.textContent = BUILD_STEPS[i];
  }, 9000);

  try{
    const res = await fetch(WORKER_URL, {
      method:'POST',
      headers:{ 'Content-Type':'application/json' },
      body: JSON.stringify({
        action:'preview',
        spec: currentSpec,
        site: currentSite,
        brand: currentBrand
      })
    });
    const data = await res.json();
    clearInterval(t);

    if(data.doc){
      const host = currentSpec.source_url
        ? String(currentSpec.source_url).replace(/^https?:\/\//,'').replace(/\/$/,'')
        : 'your site';
      document.getElementById('buildAddr').textContent = host;
      document.getElementById('buildFrame').srcdoc = data.doc;
      stage.style.display = 'block';
      cta.innerHTML = '<h4>Here it is — built and running.</h4>' +
        '<p style="margin:0;">This is your actual tool, not a mockup. Reserve below and we install it on your site.</p>';
      stage.scrollIntoView({ behavior:'smooth', block:'center' });
    } else {
      cta.innerHTML = '<h4>The build did not finish.</h4><p>' +
        (data.error ? esc(data.error) : 'Give it another go.') +
        '</p><button class="btn-deposit" onclick="buildItLive()">Try again</button>';
    }
  }catch(e){
    clearInterval(t);
    cta.innerHTML = '<h4>The build did not finish.</h4><p>Check your connection and try once more.</p>' +
      '<button class="btn-deposit" onclick="buildItLive()">Try again</button>';
  }
}

function specToText(s){
  return `TOOL: ${s.tool_name} (${s.tier} build)
${s.tagline}

MY SITE: ${s.source_url || 'n/a'}

WHAT IT DOES: ${s.what_it_does}
WHERE IT GOES: ${s.where_it_goes}
PROBLEM SOLVED: ${s.problem_solved}
FEATURES: ${(s.features||[]).join('; ')}
PRICE: $${s.price} — ready in ${s.build_days} business days`;
}

function startDeposit(){
  if(!currentSpec) return;
  const subject = encodeURIComponent(`Reserve my build — ${currentSpec.tool_name}`);
  const body = encodeURIComponent(
`I'd like to reserve this build with the $250 deposit.

${specToText(currentSpec)}

MY DETAILS
Name:
Business:
Phone:

(Send me the deposit link and we'll get started.)`);
  window.location.href = `mailto:hello@tailoredtool.com?subject=${subject}&body=${body}`;
}

function requestChanges(){
  if(!currentSpec) return;
  const subject = encodeURIComponent(`Changes to my spec — ${currentSpec.tool_name}`);
  const body = encodeURIComponent(
`I like the direction but I'd like some changes before reserving.

${specToText(currentSpec)}

WHAT I'D CHANGE:
`);
  window.location.href = `mailto:hello@tailoredtool.com?subject=${subject}&body=${body}`;
}

function resetScan(openFallback){
  currentSpec = null;
  document.getElementById('answerView').classList.remove('show');
  document.getElementById('loadingView').style.display = 'none';
  document.getElementById('askView').style.display = 'block';
  if(openFallback){
    showFallback();
  } else {
    const si = document.getElementById('siteInput');
    si.value = ''; si.focus();
  }
}


// ---- 3D carousel ----
const CAROUSEL_CARDS = [
  { type:'Customer-facing', title:'Writing Assistant', desc:'Helps shoppers write a personal message in seconds, always in the brand voice.', tier:'Standard', price:'$1,500' },
  { type:'Retail',          title:'Product Finder',    desc:'Reads what a shopper actually wants and puts the right product in front of them.', tier:'Simple', price:'$950' },
  { type:'Operations',      title:'Dispatch Agent',    desc:'Catches a missed call in seconds, works out how urgent it is, and books the job.', tier:'Advanced', price:'$2,800' },
  { type:'Retail',          title:'Size & Fit Advisor',desc:'Answers "will this fit me?" before checkout, so fewer orders come back.', tier:'Standard', price:'$1,500' },
  { type:'Customer-facing', title:'Shopping Assistant',desc:'A concierge on your site that answers product questions instantly.', tier:'Standard', price:'$1,500' },
  { type:'Bookings',        title:'Appointment Setter',desc:'Takes a request, checks the calendar, and confirms the slot without you touching it.', tier:'Advanced', price:'$2,800' },
  { type:'Lead capture',    title:'Quote Builder',     desc:'Asks the right questions, then hands you a qualified lead with the details filled in.', tier:'Simple', price:'$950' },
  { type:'Support',         title:'FAQ Answerer',      desc:'Answers the same twelve questions your inbox gets every week, day and night.', tier:'Simple', price:'$950' }
];

function buildCarousel(){
  const ring = document.getElementById('carouselRing');
  if(!ring) return;

  const n = CAROUSEL_CARDS.length;
  const step = 360 / n;
  const cardW = window.innerWidth < 700 ? 210 : 246;
  // radius that spaces cards evenly around the cylinder without overlap
  const radius = Math.round((cardW * 1.28) / (2 * Math.tan(Math.PI / n)));

  ring.innerHTML = CAROUSEL_CARDS.map((c, i) => `
    <article class="card3d" style="transform:rotateY(${i * step}deg) translateZ(${radius}px)">
      <div>
        <div class="c-type">${c.type}</div>
        <div class="c-title">${c.title}</div>
        <p class="c-desc">${c.desc}</p>
      </div>
      <div class="c-foot"><span>${c.tier}</span><b>${c.price}</b></div>
    </article>`).join('');
}

buildCarousel();
let carouselResize;
window.addEventListener('resize', ()=>{
  clearTimeout(carouselResize);
  carouselResize = setTimeout(buildCarousel, 200);
});

// scroll reveal
const io = new IntersectionObserver((entries)=>{
  entries.forEach((en, i)=>{
    if(en.isIntersecting){
      setTimeout(()=> en.target.classList.add('in'), i * 60);
      io.unobserve(en.target);
    }
  });
}, { threshold:0.12 });
document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

document.getElementById('contactForm').addEventListener('submit', function(e){
  e.preventDefault();
  const name = document.getElementById('name').value;
  const business = document.getElementById('business').value;
  const email = document.getElementById('email').value;
  const message = document.getElementById('message').value;
  const subject = encodeURIComponent('AI project inquiry — ' + business);
  const body = encodeURIComponent('Name: ' + name + '\nBusiness: ' + business + '\nEmail: ' + email + '\n\nProject details:\n' + message);
  window.location.href = 'mailto:hello@tailoredtool.com?subject=' + subject + '&body=' + body;
  document.getElementById('confirmMsg').style.display = 'block';
});
</script>

</body>
