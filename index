<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tailored Tool — Custom AI Built For Your Business</title>
<link rel="icon" type="image/svg+xml" href='data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120"><defs><linearGradient id="tg" x1="0%25" y1="0%25" x2="100%25" y2="100%25"><stop offset="0%25" stop-color="%237b6cff"/><stop offset="100%25" stop-color="%234fd8e8"/></linearGradient></defs><rect width="120" height="120" rx="26" fill="%23101017"/><rect x="24" y="28" width="60" height="13" rx="3.5" fill="url(%23tg)"/><rect x="47" y="28" width="13" height="60" rx="3.5" fill="url(%23tg)"/><rect x="60" y="55" width="34" height="12" rx="3.5" fill="%234fd8e8" opacity="0.9"/><rect x="70" y="55" width="12" height="34" rx="3.5" fill="%234fd8e8" opacity="0.9"/></svg>'>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  *{ box-sizing:border-box; margin:0; padding:0; }
  html{ scroll-behavior:smooth; }
  :root{
    --bg:#08080c;
    --surface:#101017;
    --surface-2:#16161f;
    --line:#26263300;
    --border:#282836;
    --indigo:#7b6cff;
    --indigo-bright:#9d92ff;
    --cyan:#4fd8e8;
    --text:#f2f2f7;
    --muted:#a5a5b8;
    --dim:#71718a;
  }
  body{
    background:var(--bg); color:var(--text);
    font-family:'Inter', -apple-system, sans-serif; font-size:16px; line-height:1.6;
    -webkit-font-smoothing:antialiased; overflow-x:hidden;
  }
  a{ color:inherit; text-decoration:none; }
  ::selection{ background:var(--indigo); color:#fff; }

  /* ambient glow */
  .ambient{
    position:fixed; top:-30%; left:50%; transform:translateX(-50%);
    width:1100px; height:900px; pointer-events:none; z-index:0;
    background:radial-gradient(ellipse at center, rgba(123,108,255,0.16), transparent 62%);
    filter:blur(60px);
  }

  .wrap{ position:relative; z-index:1; }

  /* ---------- NAV ---------- */
  nav{
    position:sticky; top:0; z-index:30;
    display:flex; justify-content:space-between; align-items:center;
    padding:18px 5vw; background:rgba(8,8,12,0.72); backdrop-filter:blur(14px);
    border-bottom:1px solid var(--border);
  }
  .brand{ display:flex; align-items:center; gap:12px; font-weight:700; font-size:19px; letter-spacing:-0.3px; }
  .brand .glyph{
    width:38px; height:38px;
    filter:drop-shadow(0 0 12px rgba(123,108,255,0.55));
  }
  .nav-links{ display:flex; gap:30px; font-size:14.5px; color:var(--muted); font-weight:500; }
  .nav-links a:hover{ color:var(--text); }
  .nav-cta{
    background:var(--text); color:#08080c; font-size:14px; font-weight:600;
    padding:9px 18px; border-radius:8px; transition:transform 0.15s;
  }
  .nav-cta:hover{ transform:translateY(-1px); }
  @media(max-width:760px){ .nav-links{ display:none; } }

  /* ---------- HERO ---------- */
  .hero{ max-width:900px; margin:0 auto; padding:80px 5vw 90px; text-align:center; }
  .badge{
    display:inline-flex; align-items:center; gap:9px;
    border:1px solid var(--border); background:var(--surface);
    border-radius:100px; padding:7px 16px; font-size:13.5px; color:var(--muted);
    margin-bottom:30px; font-weight:500;
  }
  .badge .pulse{
    width:7px; height:7px; border-radius:50%; background:var(--cyan);
    box-shadow:0 0 10px var(--cyan); animation:pulse 2s ease-in-out infinite;
  }
  @keyframes pulse{ 0%,100%{ opacity:1; } 50%{ opacity:0.35; } }

  h1{
    font-size:clamp(36px,6vw,66px); font-weight:800; line-height:1.05;
    letter-spacing:-2px; margin-bottom:22px;
  }
  h1 .grad{
    background:linear-gradient(120deg, var(--indigo-bright), var(--cyan));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .hero-sub{
    font-size:19px; color:var(--muted); max-width:56ch; margin:0 auto 46px; line-height:1.6;
  }

  /* fade-up animation */
  .fade{ opacity:0; transform:translateY(24px); animation:fadeUp 0.75s cubic-bezier(.16,1,.3,1) forwards; }
  .d1{ animation-delay:0.05s; } .d2{ animation-delay:0.16s; } .d3{ animation-delay:0.28s; } .d4{ animation-delay:0.4s; }
  @keyframes fadeUp{ to{ opacity:1; transform:translateY(0); } }

  /* ---------- DEMO CARD ---------- */
  .demo{
    background:var(--surface); border:1px solid var(--border); border-radius:18px;
    padding:34px 30px; text-align:left; position:relative; overflow:hidden;
    box-shadow:0 30px 70px rgba(0,0,0,0.6), 0 0 0 1px rgba(123,108,255,0.08);
  }
  .demo::before{
    content:""; position:absolute; top:0; left:12%; right:12%; height:1px;
    background:linear-gradient(90deg, transparent, var(--indigo), transparent);
  }
  .demo-title{
    font-size:20px; font-weight:700; margin-bottom:6px; letter-spacing:-0.4px;
  }
  .demo-note{ font-size:14.5px; color:var(--muted); margin-bottom:22px; }

  .input-row{ display:flex; gap:10px; }
  .input-row input{
    flex:1; background:var(--surface-2); border:1px solid var(--border); border-radius:10px;
    padding:15px 17px; font-family:inherit; font-size:16px; color:var(--text); outline:none;
    transition:border-color 0.2s, box-shadow 0.2s;
  }
  .input-row input::placeholder{ color:var(--dim); }
  .input-row input:focus{ border-color:var(--indigo); box-shadow:0 0 0 3px rgba(123,108,255,0.16); }
  .input-row button{
    background:linear-gradient(135deg, var(--indigo), #6355e8); color:#fff; border:none;
    padding:0 28px; border-radius:10px; font-family:inherit; font-size:15px; font-weight:600;
    cursor:pointer; white-space:nowrap; transition:transform 0.15s, filter 0.2s;
  }
  .input-row button:hover{ transform:translateY(-1px); filter:brightness(1.12); }
  .input-row button:disabled{ opacity:0.6; cursor:wait; transform:none; }
  @media(max-width:560px){ .input-row{ flex-direction:column; } .input-row button{ padding:14px; } }

  .chips{ margin-top:16px; display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
  .chips .lbl{ font-size:13.5px; color:var(--dim); margin-right:2px; }
  .chips button{
    background:var(--surface-2); border:1px solid var(--border); border-radius:100px;
    color:var(--muted); font-family:inherit; font-size:13.5px; padding:7px 14px; cursor:pointer;
    transition:all 0.18s;
  }
  .chips button:hover{ border-color:var(--indigo); color:var(--text); background:rgba(123,108,255,0.1); }

  /* answer state */
  .answer{ display:none; }
  .answer.show{ display:block; animation:fadeUp 0.5s cubic-bezier(.16,1,.3,1) forwards; }
  .answer-head{
    display:flex; align-items:center; gap:9px; font-size:13px; font-weight:600;
    color:var(--cyan); text-transform:uppercase; letter-spacing:0.8px; margin-bottom:16px;
  }
  .answer-body{
    font-size:17px; line-height:1.75; color:var(--text); white-space:pre-wrap;
    background:var(--surface-2); border:1px solid var(--border); border-radius:12px; padding:22px 20px;
  }
  .answer-actions{ margin-top:22px; display:flex; align-items:center; gap:20px; flex-wrap:wrap; }
  .answer-actions .primary{
    background:linear-gradient(135deg, var(--indigo), #6355e8); color:#fff;
    padding:13px 26px; border-radius:10px; font-size:15px; font-weight:600;
    transition:transform 0.15s, filter 0.2s;
  }
  .answer-actions .primary:hover{ transform:translateY(-1px); filter:brightness(1.12); }
  .answer-actions .again{
    background:none; border:none; color:var(--muted); font-family:inherit; font-size:14.5px;
    cursor:pointer; text-decoration:underline; text-underline-offset:3px;
  }
  .answer-actions .again:hover{ color:var(--text); }
  .loading{ display:flex; align-items:center; gap:10px; color:var(--muted); font-size:15px; padding:8px 0; }
  .loading .spin{
    width:16px; height:16px; border:2px solid var(--border); border-top-color:var(--indigo);
    border-radius:50%; animation:spin 0.7s linear infinite;
  }
  @keyframes spin{ to{ transform:rotate(360deg); } }

  /* ---------- SPEC CARD ---------- */
  .spec-verified{
    display:flex; align-items:flex-start; gap:10px; font-size:14px; color:var(--muted);
    background:rgba(79,216,232,0.07); border:1px solid rgba(79,216,232,0.25);
    border-radius:10px; padding:13px 15px; margin-bottom:24px;
  }
  .spec-verified .tick{ color:var(--cyan); font-weight:700; flex-shrink:0; }
  .spec-tier{
    display:inline-block; font-size:11.5px; font-weight:700; letter-spacing:1px; text-transform:uppercase;
    color:var(--cyan); background:rgba(79,216,232,0.1); border:1px solid rgba(79,216,232,0.28);
    padding:5px 12px; border-radius:100px; margin-bottom:14px;
  }
  .spec-name{ font-size:clamp(24px,3.4vw,34px); font-weight:800; letter-spacing:-0.8px; margin-bottom:6px; }
  .spec-tagline{ font-size:16.5px; color:var(--muted); margin-bottom:28px; }
  .spec-block{ margin-bottom:22px; padding-bottom:22px; border-bottom:1px solid var(--border); }
  .spec-block:last-of-type{ border-bottom:none; }
  .spec-label{
    font-size:11.5px; font-weight:700; letter-spacing:1.2px; text-transform:uppercase;
    color:var(--indigo-bright); margin-bottom:9px;
  }
  .spec-text{ font-size:15.5px; line-height:1.7; }
  .spec-features{ list-style:none; display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  @media(max-width:600px){ .spec-features{ grid-template-columns:1fr; } }
  .spec-features li{ font-size:14.5px; color:var(--text); padding-left:22px; position:relative; }
  .spec-features li::before{ content:"✓"; position:absolute; left:0; color:var(--cyan); font-weight:700; }

  .spec-price-row{
    display:flex; justify-content:space-between; align-items:flex-end; gap:20px; flex-wrap:wrap;
    background:var(--surface-2); border:1px solid var(--border); border-radius:14px;
    padding:24px 24px; margin:28px 0 20px;
  }
  .spec-price .amt{
    font-size:38px; font-weight:800; letter-spacing:-1.5px; line-height:1;
    background:linear-gradient(120deg, var(--text), var(--indigo-bright));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .spec-price .sub{ font-size:13.5px; color:var(--muted); margin-top:6px; }
  .spec-time{ text-align:right; }
  .spec-time .k{ font-size:11.5px; text-transform:uppercase; letter-spacing:1px; color:var(--dim); margin-bottom:5px; }
  .spec-time .v{ font-size:18px; font-weight:700; }
  @media(max-width:600px){ .spec-time{ text-align:left; } }

  .spec-actions{ display:flex; gap:12px; flex-wrap:wrap; align-items:center; }
  .btn-deposit{
    background:linear-gradient(135deg, var(--indigo), #6355e8); color:#fff; border:none;
    padding:15px 28px; border-radius:10px; font-family:inherit; font-size:15.5px; font-weight:700;
    cursor:pointer; transition:transform 0.15s, filter 0.2s;
  }
  .btn-deposit:hover{ transform:translateY(-1px); filter:brightness(1.12); }
  .btn-ghost{
    background:transparent; border:1px solid var(--border); color:var(--text);
    padding:14px 22px; border-radius:10px; font-family:inherit; font-size:15px; font-weight:500;
    cursor:pointer; transition:border-color 0.2s;
  }
  .btn-ghost:hover{ border-color:var(--indigo); }
  .spec-again{
    background:none; border:none; color:var(--muted); font-family:inherit; font-size:14.5px;
    cursor:pointer; text-decoration:underline; text-underline-offset:3px;
  }
  .spec-again:hover{ color:var(--text); }

  .trust-row{
    display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-top:22px;
  }
  @media(max-width:600px){ .trust-row{ grid-template-columns:1fr; } }
  .trust-item{
    background:var(--surface-2); border:1px solid var(--border); border-radius:10px;
    padding:14px 15px; font-size:13px; color:var(--muted); line-height:1.5;
  }
  .trust-item b{ display:block; color:var(--text); font-size:13.5px; margin-bottom:3px; }

  .offer-strip{
    margin-top:18px; background:rgba(123,108,255,0.1); border:1px solid rgba(123,108,255,0.3);
    border-radius:10px; padding:14px 16px; font-size:14px; color:var(--text);
  }
  .offer-strip b{ color:var(--indigo-bright); }

  .spec-err{ font-size:15.5px; line-height:1.7; color:var(--text); }

  /* ---------- 3D CAROUSEL ---------- */
  .carousel-scene{
    position:relative; height:400px; margin:10px -5vw 0;
    perspective:1400px; perspective-origin:50% 45%;
    overflow:hidden;
  }
  .carousel-scene::before,
  .carousel-scene::after{
    content:""; position:absolute; top:0; bottom:0; width:18%; z-index:5; pointer-events:none;
  }
  .carousel-scene::before{ left:0; background:linear-gradient(90deg, var(--bg) 12%, transparent); }
  .carousel-scene::after{ right:0; background:linear-gradient(270deg, var(--bg) 12%, transparent); }

  .carousel-ring{
    position:absolute; top:50%; left:50%; width:0; height:0;
    transform-style:preserve-3d;
    animation:ring-spin 46s linear infinite;
  }
  .carousel-scene:hover .carousel-ring,
  .carousel-scene:focus-within .carousel-ring{ animation-play-state:paused; }
  @keyframes ring-spin{ from{ transform:rotateY(0deg); } to{ transform:rotateY(-360deg); } }

  .card3d{
    position:absolute; width:246px; height:290px; left:-123px; top:-145px;
    background:var(--surface); border:1px solid var(--border); border-radius:16px;
    padding:24px 22px; display:flex; flex-direction:column; justify-content:space-between;
    backface-visibility:hidden;
    box-shadow:0 18px 44px rgba(0,0,0,0.55);
    transition:border-color 0.25s;
  }
  .card3d:hover{ border-color:var(--indigo); }
  .card3d .c-type{
    font-size:11px; font-weight:700; letter-spacing:1.1px; text-transform:uppercase;
    color:var(--cyan); margin-bottom:12px;
  }
  .card3d .c-title{ font-size:19px; font-weight:800; letter-spacing:-0.4px; line-height:1.2; margin-bottom:10px; }
  .card3d .c-desc{ font-size:13.5px; color:var(--muted); line-height:1.55; }
  .card3d .c-foot{
    font-size:12px; color:var(--dim); padding-top:14px; border-top:1px solid var(--border);
    display:flex; justify-content:space-between; align-items:center;
  }
  .card3d .c-foot b{ color:var(--indigo-bright); font-weight:700; }

  @media(max-width:700px){
    .carousel-scene{ height:340px; perspective:1000px; }
    .card3d{ width:210px; height:255px; left:-105px; top:-127px; padding:20px 18px; }
    .card3d .c-title{ font-size:17px; }
  }
  @media(prefers-reduced-motion:reduce){
    .carousel-ring{ animation:none; }
  }

  /* ---------- LIVE BUILD ---------- */
  .build-cta{
    background:linear-gradient(135deg, rgba(123,108,255,0.16), rgba(79,216,232,0.10));
    border:1px solid rgba(123,108,255,0.35); border-radius:14px;
    padding:22px 22px; margin:26px 0 4px;
  }
  .build-cta h4{ font-size:18px; font-weight:800; letter-spacing:-0.4px; margin-bottom:6px; }
  .build-cta p{ font-size:14.5px; color:var(--muted); margin-bottom:16px; }
  .build-stage{ margin-top:26px; }
  .build-frame-wrap{
    border:1px solid var(--border); border-radius:14px; overflow:hidden; background:#fff;
    box-shadow:0 22px 50px rgba(0,0,0,0.5);
  }
  .build-chrome{
    display:flex; align-items:center; gap:8px; padding:10px 14px;
    background:#e9e9ef; border-bottom:1px solid #d3d3dd;
  }
  .build-chrome .dot{ width:11px; height:11px; border-radius:50%; background:#c6c6d2; }
  .build-chrome .addr{
    flex:1; background:#fff; border-radius:6px; padding:5px 11px; font-size:12.5px;
    color:#5a5a6a; text-align:center; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .build-frame{ width:100%; height:560px; border:0; display:block; background:#fff; }
  .build-caption{
    display:flex; justify-content:space-between; align-items:center; gap:14px; flex-wrap:wrap;
    margin-top:14px; font-size:13.5px; color:var(--muted);
  }
  .build-live{
    display:inline-flex; align-items:center; gap:8px; font-weight:600; color:var(--cyan);
  }
  .build-live .pulse{ width:7px; height:7px; border-radius:50%; background:var(--cyan); box-shadow:0 0 10px var(--cyan); animation:pulse 2s ease-in-out infinite; }

  /* ---------- HOW IT WORKS ---------- */
  .steps{ max-width:1000px; margin:0 auto; padding:80px 5vw; }
  .steps-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
  @media(max-width:800px){ .steps-grid{ grid-template-columns:1fr; } }
  .step{
    background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:28px 24px;
    transition:border-color 0.25s, transform 0.25s;
  }
  .step:hover{ border-color:var(--indigo); transform:translateY(-3px); }
  .step .n{
    display:inline-flex; align-items:center; justify-content:center;
    width:32px; height:32px; border-radius:9px; margin-bottom:16px;
    background:rgba(123,108,255,0.14); border:1px solid rgba(123,108,255,0.3);
    color:var(--indigo-bright); font-weight:700; font-size:14px;
  }
  .step h3{ font-size:17.5px; font-weight:700; margin-bottom:8px; letter-spacing:-0.3px; }
  .step p{ font-size:14.5px; color:var(--muted); line-height:1.6; }

  /* ---------- SECTIONS ---------- */
  section{ max-width:1000px; margin:0 auto; padding:80px 5vw; }
  .sec-tag{
    display:inline-block; font-family:'JetBrains Mono',monospace; font-size:12px;
    letter-spacing:1.5px; text-transform:uppercase; color:var(--indigo-bright); margin-bottom:14px;
  }
  h2{ font-size:clamp(26px,3.6vw,40px); font-weight:800; letter-spacing:-1px; margin-bottom:14px; }
  .sec-lede{ color:var(--muted); font-size:16px; max-width:56ch; margin-bottom:46px; }

  .work-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(290px,1fr)); gap:16px; }
  .work-card{
    background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:26px 22px;
    transition:border-color 0.25s, transform 0.25s;
  }
  .work-card:hover{ border-color:var(--indigo); transform:translateY(-3px); }
  .work-card .type{
    font-size:11.5px; font-weight:600; letter-spacing:1px; text-transform:uppercase;
    color:var(--cyan); margin-bottom:12px;
  }
  .work-card h3{ font-size:18px; font-weight:700; margin-bottom:10px; letter-spacing:-0.3px; }
  .work-card p{ font-size:14.5px; color:var(--muted); line-height:1.6; }

  .price-card{
    background:var(--surface); border:1px solid var(--border); border-radius:18px;
    padding:44px 38px; max-width:620px; position:relative; overflow:hidden;
  }
  .price-card::before{
    content:""; position:absolute; top:0; left:8%; right:8%; height:1px;
    background:linear-gradient(90deg, transparent, var(--indigo), transparent);
  }
  .price-fig{
    font-size:clamp(34px,5vw,50px); font-weight:800; letter-spacing:-1.5px; margin-bottom:8px;
    background:linear-gradient(120deg, var(--text), var(--indigo-bright));
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .price-note{ color:var(--muted); font-size:15px; margin-bottom:30px; }
  .price-list{ list-style:none; }
  .price-list li{ font-size:15px; padding:13px 0 13px 30px; position:relative; border-top:1px solid var(--border); }
  .price-list li:first-child{ border-top:none; }
  .price-list li::before{
    content:"✓"; position:absolute; left:0; color:var(--cyan); font-weight:700;
  }

  .contact-grid{ display:grid; grid-template-columns:1.1fr 0.9fr; gap:60px; }
  @media(max-width:800px){ .contact-grid{ grid-template-columns:1fr; gap:40px; } }
  .field{ margin-bottom:20px; }
  .field label{ display:block; font-size:13.5px; font-weight:500; margin-bottom:8px; color:var(--muted); }
  .field input, .field textarea{
    width:100%; background:var(--surface); border:1px solid var(--border); border-radius:10px;
    padding:13px 15px; font-family:inherit; font-size:15px; color:var(--text); outline:none;
    transition:border-color 0.2s, box-shadow 0.2s;
  }
  .field input:focus, .field textarea:focus{ border-color:var(--indigo); box-shadow:0 0 0 3px rgba(123,108,255,0.16); }
  .field textarea{ min-height:100px; resize:vertical; }
  .submit{
    background:linear-gradient(135deg, var(--indigo), #6355e8); color:#fff; border:none;
    padding:14px 30px; border-radius:10px; font-family:inherit; font-size:15px; font-weight:600;
    cursor:pointer; transition:transform 0.15s, filter 0.2s;
  }
  .submit:hover{ transform:translateY(-1px); filter:brightness(1.12); }
  .confirm{ display:none; margin-top:16px; font-size:14px; color:var(--cyan); }
  .info-line{ margin-bottom:26px; }
  .info-line .k{ font-size:12.5px; text-transform:uppercase; letter-spacing:1px; color:var(--dim); margin-bottom:6px; }
